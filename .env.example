# Copy to `.env`. Every setting is optional; these are the defaults.
# Read by `docker compose` (and by your process manager if you run it bare).

# Host port to publish the portal on.
PORT=3000

# Set to 1 behind a reverse proxy that terminates TLS.
TRUST_PROXY=0

# Starting size limit for files attached to requests. Administrators can
# change it later under Settings without restarting.
MAX_UPLOAD_MB=10

# Signs session cookies. Leave unset to have one generated and stored in the
# data directory; set it explicitly if you want sessions to survive a wipe of
# that directory or run more than one instance.
#SESSION_SECRET=change-me-to-a-long-random-string

# Only used when running without Docker (the image fixes this to /data).
#HOST=0.0.0.0
#PORTAL_DATA_DIR=/var/lib/aperturekit
