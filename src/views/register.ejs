<%- include('partials/head') %>
<section class="auth">
  <div class="auth-brand">
    <span class="brand-mark" aria-hidden="true"></span>
    <h1>Create your account</h1>
    <p>You need an account to send requests and follow their progress.</p>
  </div>
  <div class="card auth-card">
    <% if (locals.error) { %><p class="field-error" role="alert" style="margin:0"><%- include('partials/icon', { name: 'alert' }) %><span><%= error %></span></p><% } %>
    <form method="post" action="/register" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Your name</span><input name="name" value="<%= values.name || '' %>" required autocomplete="name" autofocus></label>
      <label class="field"><span>Email</span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
        <% if (domains.length) { %><small>Use an address ending in <%= domains.map((d) => '@' + d).join(' or ') %>.</small><% } %>
      </label>
      <label class="field"><span>Password</span><input type="password" name="password" required minlength="8" autocomplete="new-password"><small>At least 8 characters.</small></label>
      <button class="btn btn-primary btn-lg" type="submit">Create account</button>
    </form>
  </div>
  <p class="auth-foot">Already have one? <a href="/login">Sign in</a></p>
</section>
<%- include('partials/foot') %>
