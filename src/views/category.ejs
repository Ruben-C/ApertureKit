<%- include('partials/head') %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/"><%= t('nav.forms') %></a><%- include('partials/icon', { name: 'chevron-right' }) %><span><%= category.name %></span></nav>
<header class="cat-hero" style="--cat:<%= category.color %>">
  <span class="tile tile-lg" aria-hidden="true"><%= category.name.trim()[0].toUpperCase() %></span>
  <div>
    <h1><%= category.name %></h1>
    <% if (category.description) { %><p class="lede"><%= category.description %></p><% } %>
  </div>
</header>
<% if (!forms.length) { %>
  <div class="card empty">
    <span class="tile tile-lg" style="--cat:<%= category.color %>"><%- include('partials/icon', { name: 'folder' }) %></span>
    <h2><%= t('category.nothing_here_yet') %></h2>
    <p><%= t('category.no_forms_in_category') %> <a href="/"><%= t('category.see_all_forms') %></a>.</p>
  </div>
<% } else { %>
  <div class="form-cards">
    <% for (const f of forms) { %>
      <a class="card form-card" href="/f/<%= f.slug %>" style="--cat:<%= category.color %>">
        <h2><%= f.title %></h2>
        <% if (f.description) { %><p><%= f.description %></p><% } %>
        <span class="form-card-go"><%= t('category.open_form') %><%- include('partials/icon', { name: 'chevron-right', cls: 'icon-sm' }) %></span>
      </a>
    <% } %>
  </div>
<% } %>
<%- include('partials/foot') %>
