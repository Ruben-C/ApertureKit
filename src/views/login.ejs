<%- include('partials/head') %>
<section class="auth">
  <div class="auth-brand">
    <span class="brand-mark" aria-hidden="true"></span>
    <h1><%= t('auth.sign_in_title', { site_name: settings.site_name }) %></h1>
    <% if (settings.login_text) { %><p><%= settings.login_text %></p><% } %>
  </div>
  <div class="card auth-card">
    <% if (locals.error) { %><p class="field-error" role="alert" style="margin:0"><%- include('partials/icon', { name: 'alert' }) %><span><%= error %></span></p><% } %>

    <% if (signIn.buttons.length) { %>
      <div class="sso-buttons">
        <% for (const b of signIn.buttons) { %>
          <a class="btn btn-sso" href="/auth/<%= b.id %>/start"><%- include('partials/icon', { name: 'shield' }) %><%= t('auth.continue_with', { name: b.name }) %></a>
        <% } %>
      </div>
      <% if (showPassword) { %><p class="or-rule"><span><%= t('auth.or_with_password') %></span></p><% } %>
    <% } %>

    <% if (showPassword) { %>
      <form method="post" action="/login" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (signIn.ldap) { %>
          <label class="field"><span><%= t('auth.username_or_email') %></span><input type="text" name="email" value="<%= values.email || '' %>" required autocomplete="username" autofocus></label>
        <% } else { %>
          <label class="field"><span><%= t('auth.email') %></span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email" autofocus></label>
        <% } %>
        <label class="field"><span><%= t('auth.password') %></span><input type="password" name="password" required autocomplete="current-password"></label>
        <button class="btn btn-primary btn-lg" type="submit"><%= t('auth.sign_in') %></button>
      </form>
    <% } else if (!signIn.buttons.length) { %>
      <p class="notice"><%- include('partials/icon', { name: 'alert' }) %><span><%- t('auth.no_sign_in_methods', { url: '<a href="/login?password=1">/login?password=1</a>' }) %></span></p>
    <% } %>
  </div>
  <% if (settings.allow_registration === '1' && signIn.password) { %><p class="auth-foot"><%= t('auth.new_here') %> <a href="/register"><%= t('auth.create_account') %></a></p><% } %>
</section>
<%- include('partials/foot') %>
