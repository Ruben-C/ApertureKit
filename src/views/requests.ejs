<%- include('partials/head') %>
<% const base = mine && isEditor ? '/requests?mine=1' : '/requests';
   const join = base.includes('?') ? '&' : '?';
   const total = Object.values(counts).reduce((a, b) => a + b, 0);
   const open = (counts.new || 0) + (counts.in_progress || 0); %>
<div class="page-head">
  <div>
    <h1><%= isEditor && !mine ? 'Queue' : 'My requests' %></h1>
    <p class="lede"><% if (total) { %><span class="num"><%= open %></span> open · <span class="num"><%= total %></span> in total<% } else if (mine) { %>Everything you send shows up here.<% } else { %>Requests from members show up here.<% } %></p>
  </div>
  <div class="page-actions">
    <% if (isEditor) { %>
      <nav class="segmented" aria-label="Whose requests">
        <a href="/requests" <%= !mine ? 'aria-current="page"' : '' %>><%- include('partials/icon', { name: 'inbox', cls: 'icon-sm' }) %>Everyone</a>
        <a href="/requests?mine=1" <%= mine ? 'aria-current="page"' : '' %>><%- include('partials/icon', { name: 'user', cls: 'icon-sm' }) %>Mine</a>
      </nav>
    <% } %>
    <a class="btn btn-primary" href="/"><%- include('partials/icon', { name: 'plus' }) %>New request</a>
  </div>
</div>

<div class="toolbar">
  <nav class="tabs" aria-label="Filter by status" style="margin:0;border:0">
    <a href="<%= base %>" <%= !status ? 'aria-current="page"' : '' %>>All <span class="count"><%= total %></span></a>
    <% for (const [key, label] of Object.entries(STATUS)) { %>
      <a href="<%= base + join %>status=<%= key %>" <%= status === key ? 'aria-current="page"' : '' %>><span class="status status-<%= key %> status-dot"></span><%= label %> <span class="count"><%= counts[key] || 0 %></span></a>
    <% } %>
  </nav>
  <% if (requests.length > 3) { %>
    <form class="search" role="search" data-no-busy>
      <%- include('partials/icon', { name: 'search' }) %>
      <label class="visually-hidden" for="req-filter">Filter this list</label>
      <input id="req-filter" type="search" data-filter="requests-list" placeholder="Filter by title, number, person…" autocomplete="off">
    </form>
  <% } %>
</div>

<% if (!requests.length) { %>
  <div class="card empty">
    <span class="tile tile-lg"><%- include('partials/icon', { name: status ? 'inbox' : 'file' }) %></span>
    <h2><%= status ? `Nothing ${STATUS[status].toLowerCase()}` : 'No requests yet' %></h2>
    <% if (mine) { %><p>Pick a form and send your first request. It will land here with a ticket number you can follow.</p><a class="btn btn-primary" href="/">Browse the forms</a><% } else { %><p>Requests from members will show up here as they come in.</p><% } %>
  </div>
<% } else { %>
  <div id="requests-list">
  <ol class="list card requests-list">
    <% for (const r of requests) {
         // One glyph per kind of question on the form, in form order.
         const types = [...new Set(r.snapshot.fields.filter((f) => FIELD_TYPES[f.type] && !FIELD_TYPES[f.type].display).map((f) => f.type))];
         const typeNames = types.map((t) => FIELD_TYPES[t].label).join(', ');
    %>
      <li data-filter-item>
        <a class="list-row ticket-row" href="/requests/<%= r.id %>">
          <span class="ticket-no"><%= ticket(r.id) %></span>
          <span class="ticket-main">
            <span class="ticket-title"><%= r.snapshot.title %></span>
            <span class="ticket-meta">
              <span><%= r.snapshot.category %></span>
              <% if (!mine) { %><span class="sep">·</span><span class="avatar avatar-sm" style="--hue:<%= hue(r.requester) %>" aria-hidden="true"><%= initials(r.requester) %></span><span><%= r.requester %></span><% } %>
              <% if (types.length) { %><span class="sep">·</span><span class="ticket-types" title="<%= typeNames %>"><span class="visually-hidden">Questions: <%= typeNames %>.</span><% for (const t of types) { %><svg class="ficon" aria-hidden="true" focusable="false"><use href="#ficon-<%= t %>"/></svg><% } %></span><% } %>
            </span>
          </span>
          <time datetime="<%= r.created_at %>" title="<%= fmtDate(r.created_at) %>"><%= fmtAgo(r.created_at) %></time>
          <span class="status status-<%= r.status %>"><%= STATUS[r.status] %></span>
        </a>
      </li>
    <% } %>
  </ol>
  <div class="card empty" data-filter-empty hidden style="margin-top:1rem">
    <h2>No matches</h2>
    <p>Nothing in this list matches what you typed.</p>
  </div>
  </div>
  <%- include('partials/field_sprite') %>
<% } %>
<%- include('partials/foot') %>
