<%- include('partials/head') %>
<section class="narrow">
  <h1>Set up your portal</h1>
  <p class="lede">Create the first administrator account. You can rename the portal, add a banner, and invite editors right after.</p>
  <% if (locals.error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/setup" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>Your name</span><input name="name" value="<%= values.name || '' %>" required autocomplete="name"></label>
    <label class="field"><span>Email</span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"></label>
    <label class="field"><span>Password</span><input type="password" name="password" required minlength="8" autocomplete="new-password"><small>At least 8 characters.</small></label>
    <div class="actions"><button class="btn btn-primary" type="submit">Create administrator</button></div>
  </form>
</section>
<%- include('partials/foot') %>
