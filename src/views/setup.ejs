<%- include('partials/head') %>
<section class="auth">
  <div class="auth-brand">
    <span class="brand-mark" aria-hidden="true"></span>
    <h1><%= t('auth.setup_title') %></h1>
    <p><%= t('auth.setup_blurb') %></p>
  </div>
  <div class="setup-steps" aria-label="Steps">
    <span><%= t('auth.setup_step_admin') %></span>
    <span><%= t('auth.setup_step_branding') %></span>
    <span><%= t('auth.setup_step_invite') %></span>
  </div>
  <div class="card auth-card">
    <% if (locals.error) { %><p class="field-error" role="alert" style="margin:0"><%- include('partials/icon', { name: 'alert' }) %><span><%= error %></span></p><% } %>
    <form method="post" action="/setup" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span><%= t('auth.your_name') %></span><input name="name" value="<%= values.name || '' %>" required autocomplete="name" autofocus></label>
      <label class="field"><span><%= t('auth.email') %></span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"></label>
      <label class="field"><span><%= t('auth.password') %></span><input type="password" name="password" required minlength="8" autocomplete="new-password"><small><%= t('auth.password_min_length') %></small></label>
      <button class="btn btn-primary btn-lg" type="submit"><%= t('auth.create_admin_button') %></button>
    </form>
  </div>
</section>
<%- include('partials/foot') %>
