<%- include('../partials/head', { wide: true }) %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/editor"><%= t('editor.categories_and_forms') %></a><%- include('../partials/icon', { name: 'chevron-right' }) %><span><%= form.id ? form.title : t('editor.new_form') %></span></nav>
<div class="page-head">
  <div>
    <h1><%= form.id ? form.title : t('editor.new_form') %></h1>
    <p class="lede"><% if (form.id) { %><span class="tag <%= form.published ? 'tag-live' : 'tag-draft' %>"><span class="dot"></span><%= form.published ? t('editor.published') : t('editor.draft') %></span> &nbsp;<%= t('editor.new_form_blurb_edit') %><% } else { %><%= t('editor.new_form_blurb_new') %><% } %></p>
  </div>
  <div class="page-actions">
    <% if (form.id) { %><a class="btn" href="/f/<%= form.slug %>"><%- include('../partials/icon', { name: 'eye' }) %><%= t('common.preview') %></a><% } %>
    <button class="btn btn-primary" type="submit" form="builder-form"><%- include('../partials/icon', { name: 'check' }) %><%= form.id ? t('editor.save_form') : t('editor.create_form') %></button>
  </div>
</div>
<% if (locals.error) { %><p class="field-error" role="alert"><%- include('../partials/icon', { name: 'alert' }) %><span><%= error %></span></p><% } %>

<form method="post" action="<%= form.id ? `/editor/forms/${form.id}` : '/editor/forms' %>" class="builder" id="builder-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <div class="builder-side">
    <div class="card">
      <div class="card-head"><h2><%= t('editor.form_settings') %></h2></div>
      <div class="card-body">
        <label class="field"><span><%= t('editor.title') %></span><input name="title" value="<%= form.title %>" required maxlength="150" placeholder="<%= t('editor.title_placeholder') %>"></label>
        <label class="field"><span><%= t('editor.category') %></span>
          <select name="category_id"><% for (const c of categories) { %><option value="<%= c.id %>" <%= c.id === form.category_id ? 'selected' : '' %>><%= c.name %></option><% } %></select>
        </label>
        <label class="field"><span><%= t('editor.description') %></span><textarea name="description" rows="3" maxlength="2000"><%= form.description %></textarea><small><%= t('editor.description_help') %></small></label>
        <label class="field"><span><%= t('editor.confirmation_message') %></span><textarea name="confirmation" rows="3" maxlength="2000"><%= form.confirmation %></textarea><small><%= t('editor.confirmation_help') %></small></label>
        <label class="choice-field"><input type="checkbox" name="published" value="1" <%= form.published ? 'checked' : '' %>><span><%= t('editor.published_label') %></span><small><%= t('editor.published_help') %></small></label>
      </div>
      <div class="card-foot">
        <button class="btn btn-primary" type="submit"><%= form.id ? t('editor.save_form') : t('editor.create_form') %></button>
        <% if (form.id) { %><button class="linklike danger push" type="submit" name="action" value="delete" formnovalidate onclick="return confirm('<%= t('editor.confirm_delete_form') %>')"><%= t('editor.delete_form') %></button><% } %>
      </div>
    </div>
  </div>

  <form-builder class="builder-main" for="fields-json" types="field-types">
    <div class="builder-head">
      <h2><%= t('editor.questions') %></h2>
      <span class="muted" style="font-size:.875rem"><%= t('editor.drag_reorder') %></span>
    </div>
    <div class="field-list" data-list></div>
    <div class="card empty" data-empty hidden>
      <span class="tile tile-lg"><%- include('../partials/icon', { name: 'list' }) %></span>
      <h2><%= t('editor.no_questions_yet') %></h2>
      <p><%= t('editor.pick_type_first') %></p>
    </div>
    <div class="add-palette" role="group" aria-labelledby="add-palette-title">
      <p class="add-palette-title" id="add-palette-title"><%= t('editor.add_a_question') %></p>
      <div class="type-tiles">
        <% for (const [key, tObj] of Object.entries(FIELD_TYPES)) { %>
        <button type="button" class="type-tile" data-add="<%= key %>">
          <span class="type-tile-glyph"><svg class="ficon" aria-hidden="true" focusable="false"><use href="#ficon-<%= key %>"/></svg></span>
          <span class="type-tile-label"><%= tObj.label %></span>
        </button>
        <% } %>
      </div>
    </div>
    <details class="json-fallback" open>
      <summary><%= t('editor.questions_as_json') %></summary>
      <label class="field">
        <span class="visually-hidden"><%= t('editor.questions_as_json') %></span>
        <textarea name="fields" id="fields-json" rows="12"><%= JSON.stringify(form.fields, null, 2) %></textarea>
        <small><%= locale === 'pt-BR' ? 'Sincronizado com o construtor acima. Você também pode colar JSON aqui.' : 'Kept in step with the builder above. You can also paste JSON here.' %></small>
      </label>
    </details>
  </form-builder>
</form>

<%- include('../partials/field_sprite') %>
<script type="application/json" id="field-types"><%- JSON.stringify(FIELD_TYPES).replaceAll('<', '\\u003c') %></script>
<script type="module" src="/static/components/option-list.js?v=<%= assetVersion %>"></script>
<script type="module" src="/static/components/question-preview.js?v=<%= assetVersion %>"></script>
<script type="module" src="/static/components/field-card.js?v=<%= assetVersion %>"></script>
<script type="module" src="/static/components/form-builder.js?v=<%= assetVersion %>"></script>
<%- include('../partials/foot') %>
