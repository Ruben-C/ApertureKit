<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="<%= settings.banner_color %>">
<title><%= title ? `${title} – ${settings.site_name}` : settings.site_name %></title>
<link rel="icon" href="/static/favicon.svg?v=<%= assetVersion %>" type="image/svg+xml">
<link rel="stylesheet" href="/static/app.css?v=<%= assetVersion %>">
<style>:root{--banner:<%= settings.banner_color %>;--banner-ink:<%= settings.banner_text_color %>;}</style>
<script>document.documentElement.classList.add('js')</script>
<script type="module" src="/static/ui.js?v=<%= assetVersion %>"></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span class="brand-name"><%= settings.site_name %></span></a>
    <% if (user || settings.require_login !== '1') { %>
      <button class="icon-btn nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav" aria-label="Menu"><%- include('icon', { name: 'menu' }) %></button>
      <nav class="nav" id="main-nav" aria-label="Main">
        <a href="/" <%- path === '/' || path.startsWith('/c/') || path.startsWith('/f/') ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'home', cls: 'icon-sm' }) %>Forms</a>
        <% if (user) { %>
          <a href="/requests<%= can('editor') ? '?mine=1' : '' %>" <%- path.startsWith('/requests') && (!can('editor') || query.mine === '1') ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'file', cls: 'icon-sm' }) %>My requests</a>
          <% if (can('editor')) { %>
            <a href="/requests" <%- path.startsWith('/requests') && query.mine !== '1' ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'inbox', cls: 'icon-sm' }) %>Queue</a>
            <a href="/editor" <%- path.startsWith('/editor') ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'layers', cls: 'icon-sm' }) %>Build</a>
          <% } %>
          <% if (can('admin')) { %>
            <a href="/admin/settings" <%- path.startsWith('/admin') ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'sliders', cls: 'icon-sm' }) %>Admin</a>
          <% } %>
        <% } %>
      </nav>
    <% } %>
    <div class="topbar-right">
      <% if (user) { %>
        <details class="menu" data-menu>
          <summary aria-label="Account menu for <%= user.name %>">
            <span class="avatar" style="--hue:<%= hue(user.name) %>" aria-hidden="true"><%= initials(user.name) %></span>
            <span class="who"><%= user.name %></span>
            <%- include('icon', { name: 'chevron-down' }) %>
          </summary>
          <div class="menu-panel">
            <div class="menu-id">
              <span class="avatar" style="--hue:<%= hue(user.name) %>" aria-hidden="true"><%= initials(user.name) %></span>
              <div><strong><%= user.name %></strong><small><%= user.email %></small></div>
            </div>
            <a class="menu-item" href="/requests<%= can('editor') ? '?mine=1' : '' %>"><%- include('icon', { name: 'file' }) %>My requests</a>
            <% if (can('admin')) { %><a class="menu-item" href="/admin/users"><%- include('icon', { name: 'users' }) %>People</a><% } %>
            <div class="menu-sep"></div>
            <div class="menu-item" style="cursor:default"><span class="tag tag-role tag-role-<%= user.role %>"><%= user.role %></span></div>
            <div class="menu-sep"></div>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="menu-item" type="submit"><%- include('icon', { name: 'logout' }) %>Sign out</button>
            </form>
          </div>
        </details>
      <% } else { %>
        <div class="topbar-links">
          <% if (settings.allow_registration === '1' && signIn.password && path !== '/register') { %><a href="/register">Create account</a><% } %>
          <% if (path !== '/login') { %><a class="btn btn-sm btn-primary" href="/login">Sign in</a><% } %>
        </div>
      <% } %>
    </div>
  </div>
</header>
<% if (flash) { %>
  <div class="toasts" data-toasts>
    <div class="toast toast-<%= flash.kind %>" role="status">
      <%- include('icon', { name: flash.kind === 'error' ? 'alert' : flash.kind === 'success' ? 'check-circle' : 'info' }) %>
      <p><%= flash.message %></p>
      <button class="toast-close" type="button" data-dismiss aria-label="Dismiss"><%- include('icon', { name: 'x', cls: 'icon-sm' }) %></button>
    </div>
  </div>
<% } %>
<main id="main" class="wrap main <%= locals.wide ? 'wrap-wide' : '' %>">
