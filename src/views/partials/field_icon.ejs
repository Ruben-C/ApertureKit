<%#
  Glyph for a field type, keyed by FIELD_TYPES key: the paths only, drawn on
  a 24x24 grid in currentColor. The builder page wraps them in a sprite so
  both the type palette and <field-card> can reference the same drawings.
  Usage: include('partials/field_icon', { type: 'email' })
%>
<% switch (type) {
  case 'text': %>
  <rect x="3" y="8" width="18" height="8" rx="1.5"/><path d="M7 10.5v3"/>
<% break; case 'textarea': %>
  <rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M7 9h10M7 12h10M7 15h6"/>
<% break; case 'email': %>
  <rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3.5 8.5 12 14l8.5-5.5"/>
<% break; case 'number': %>
  <path d="M9.5 4 7.5 20M16.5 4l-2 16M4.5 9.5h16M3.5 14.5h16"/>
<% break; case 'date': %>
  <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><circle cx="8.5" cy="14.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="12" cy="14.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="14.5" r="1.1" fill="currentColor" stroke="none"/>
<% break; case 'select': %>
  <rect x="3" y="7" width="18" height="10" rx="2"/><path d="M7 12h6M14.5 11l2 2 2-2"/>
<% break; case 'radio': %>
  <circle cx="7" cy="8" r="3"/><circle cx="7" cy="8" r="1.25" fill="currentColor" stroke="none"/><circle cx="7" cy="16" r="3"/><path d="M13 8h8M13 16h8"/>
<% break; case 'checkbox': %>
  <rect x="4" y="5" width="6" height="6" rx="1"/><path d="m5.5 8 1.4 1.4L9.2 6.6"/><rect x="4" y="13" width="6" height="6" rx="1"/><path d="m5.5 16 1.4 1.4 2.3-2.8M13 8h8M13 16h8"/>
<% break; case 'yesno': %>
  <rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="16" cy="12" r="2.5" fill="currentColor" stroke="none"/>
<% break; case 'file': %>
  <path d="M12 16V6M8 10l4-4 4 4M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"/>
<% break; case 'heading': %>
  <path d="M5 5v14M14 5v14M5 12h9M18.5 4.5v15"/>
<% break; default: %>
  <circle cx="12" cy="12" r="8"/><path d="M12 8v4.5M12 15.5v.5"/>
<% } %>
