<%- include('../partials/head', { wide: true }) %>
<div class="with-subnav">
<%- include('../partials/admin_nav') %>
<div>
<div class="page-head">
  <div>
    <h1><%= t('admin.settings.title') %></h1>
    <p class="lede"><%= t('admin.settings.lede') %></p>
  </div>
</div>

<form method="post" action="/admin/settings" enctype="multipart/form-data" class="settings" data-dirty-watch>
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <section class="settings-group card settings-section" id="general" aria-labelledby="general-title">
    <header class="card-head">
      <h2 id="general-title"><%- include('../partials/icon', { name: 'edit' }) %><%= t('admin.settings.general_title') %></h2>
      <p><%= t('admin.settings.general_blurb') %></p>
    </header>
    <div class="card-body">
      <div class="form-row">
        <label class="field"><span><%= t('admin.settings.language') %></span>
          <select name="locale">
            <% for (const [key, label] of Object.entries(localeChoices)) { %>
              <option value="<%= key %>" <%= (values.locale || defaults.locale) === key ? 'selected' : '' %>><%= label %></option>
            <% } %>
          </select>
          <small><%= t('admin.settings.language_help') %></small>
        </label>
        <label class="field"><span><%= t('admin.settings.portal_name') %></span><input name="site_name" value="<%= values.site_name %>" maxlength="80" placeholder="<%= defaults.site_name %>"><small><%= t('admin.settings.portal_name_help') %></small></label>
      </div>
      <label class="field"><span><%= t('admin.settings.tagline') %></span><input name="tagline" value="<%= values.tagline %>" maxlength="200"><small><%= t('admin.settings.tagline_help') %></small></label>
      <label class="field"><span><%= t('admin.settings.welcome_text') %></span><textarea name="welcome_text" rows="2" maxlength="1000"><%= values.welcome_text %></textarea><small><%= t('admin.settings.welcome_text_help') %></small></label>
      <label class="field"><span><%= t('admin.settings.login_text') %></span><textarea name="login_text" rows="2" maxlength="500" placeholder="<%= t('admin.settings.login_text_placeholder') %>"><%= values.login_text %></textarea><small><%= t('admin.settings.login_text_help') %></small></label>
      <label class="field"><span><%= t('admin.settings.footer_text') %></span><input name="footer_text" value="<%= values.footer_text %>" maxlength="500" placeholder="<%= t('admin.settings.footer_text_placeholder') %>"><small><%= t('admin.settings.footer_text_help') %></small></label>
      <label class="choice-field"><input type="checkbox" name="show_credit" value="1" <%= values.show_credit === '1' ? 'checked' : '' %>><span><%= t('admin.settings.show_credit') %></span></label>
    </div>
  </section>

  <section class="settings-group card settings-section" id="appearance" aria-labelledby="appearance-title">
    <header class="card-head">
      <h2 id="appearance-title"><%- include('../partials/icon', { name: 'paint' }) %><%= t('admin.settings.appearance_title') %></h2>
      <p><%= t('admin.settings.appearance_blurb') %></p>
    </header>
    <div class="card-body">
      <div class="banner-preview <%= values.banner_image ? 'banner-image' : '' %>" id="banner-preview"
           style="--banner:<%= values.banner_color %>;--banner-ink:<%= values.banner_text_color %>;<% if (values.banner_image) { %>background-image:url('/branding/<%= values.banner_image %>')<% } %>">
        <div class="hero-inner">
          <p class="banner-title" id="preview-title"><%= values.site_name %></p>
          <p class="banner-tagline" id="preview-tagline"><%= values.tagline %></p>
        </div>
      </div>
      <div class="settings-row">
        <label class="field"><span><%= t('admin.settings.bg_color') %></span>
          <span class="color-pick"><input type="color" name="banner_color" value="<%= values.banner_color %>" id="banner-color"><code data-color-for="banner_color"><%= values.banner_color %></code></span>
          <small><%= t('admin.settings.bg_color_help') %></small>
        </label>
        <label class="field"><span><%= t('admin.settings.text_color') %></span>
          <span class="color-pick"><input type="color" name="banner_text_color" value="<%= values.banner_text_color %>" id="banner-ink"><code data-color-for="banner_text_color"><%= values.banner_text_color %></code></span>
          <small><%= t('admin.settings.text_color_help') %></small>
        </label>
      </div>
      <label class="field"><span><%= t('admin.settings.banner_image') %></span><input type="file" name="banner_image" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" id="banner-file"><small><%= t('admin.settings.banner_image_help') %></small></label>
      <% if (values.banner_image) { %>
        <label class="choice-field"><input type="checkbox" name="remove_banner" value="1"><span><%= t('admin.settings.remove_image') %></span></label>
      <% } %>
    </div>
  </section>

  <section class="settings-group card settings-section" id="accounts" aria-labelledby="accounts-title">
    <header class="card-head">
      <h2 id="accounts-title"><%- include('../partials/icon', { name: 'users' }) %><%= t('admin.settings.accounts_title') %></h2>
      <p><%= locale === 'pt-BR' ? 'Quem pode ver o portal e quem pode se cadastrar. Login único (SSO) e diretório são configurados em ' : 'Who can see the portal and who can join it. Single sign-on and directory sign-in are set up under ' %><a href="/admin/auth"><%= t('admin.nav.sign_in_methods') %></a>.</p>
    </header>
    <div class="card-body">
      <label class="choice-field"><input type="checkbox" name="require_login" value="1" <%= values.require_login === '1' ? 'checked' : '' %>><span><%= t('admin.settings.require_login') %></span><small><%= t('admin.settings.require_login_help') %></small></label>
      <label class="choice-field"><input type="checkbox" name="allow_registration" value="1" <%= values.allow_registration === '1' ? 'checked' : '' %>><span><%= t('admin.settings.allow_registration') %></span><small><%= t('admin.settings.allow_registration_help') %></small></label>
      <div class="form-row">
        <label class="field"><span><%= t('admin.settings.registration_domains') %></span><input name="registration_domains" value="<%= values.registration_domains %>" placeholder="<%= t('admin.settings.registration_domains_placeholder') %>"><small><%= t('admin.settings.registration_domains_help') %></small></label>
        <label class="field"><span><%= t('admin.settings.default_role') %></span>
          <select name="default_role"><% for (const r of roleChoices) { %><option value="<%= r %>" <%= values.default_role === r ? 'selected' : '' %>><%= r %></option><% } %></select>
          <small><%= locale === 'pt-BR' ? 'Membros enviam solicitações; editores também criam formulários e atendem a fila.' : 'Members send requests; editors also build forms and work the queue.' %></small>
        </label>
      </div>
      <div class="form-row">
        <label class="field"><span><%= t('admin.settings.session_idle') %></span>
          <select name="session_idle_minutes"><% for (const [key, label] of Object.entries(sessionIdleChoices)) { %><option value="<%= key %>" <%= values.session_idle_minutes === key ? 'selected' : '' %>><%= label %></option><% } %></select>
          <small><%= t('admin.settings.session_idle_help') %></small>
        </label>
        <label class="field"><span><%= t('admin.settings.session_max') %></span>
          <select name="session_max_minutes"><% for (const [key, label] of Object.entries(sessionMaxChoices)) { %><option value="<%= key %>" <%= values.session_max_minutes === key ? 'selected' : '' %>><%= label %></option><% } %></select>
          <small><%= t('admin.settings.session_max_help') %></small>
        </label>
      </div>
    </div>
  </section>

  <section class="settings-group card settings-section" id="requests" aria-labelledby="requests-title">
    <header class="card-head">
      <h2 id="requests-title"><%- include('../partials/icon', { name: 'inbox' }) %><%= t('admin.settings.requests_title') %></h2>
      <p><%= t('admin.settings.requests_blurb') %></p>
    </header>
    <div class="card-body">
      <div class="form-row">
        <label class="field"><span><%= t('admin.settings.ticket_prefix') %></span>
          <span class="inline-unit"><input name="ticket_prefix" value="<%= values.ticket_prefix %>" maxlength="8" placeholder="<%= defaults.ticket_prefix %>"> <span class="muted num" id="ticket-example">e.g. <%= values.ticket_prefix %>0042</span></span>
          <small><%= t('admin.settings.ticket_prefix_help') %></small>
        </label>
        <label class="field"><span><%= t('admin.settings.max_upload') %></span>
          <span class="inline-unit"><input type="number" name="max_upload_mb" value="<%= values.max_upload_mb %>" min="1" max="<%= uploadCeiling %>" step="1" inputmode="numeric"> <span class="muted">MB</span></span>
          <small><%= t('admin.settings.max_upload_help') %></small>
        </label>
      </div>
      <label class="field"><span><%= t('admin.settings.comments_label') %></span>
        <select name="comments" style="max-width:24rem"><% for (const [key, label] of Object.entries(commentChoices)) { %><option value="<%= key %>" <%= values.comments === key ? 'selected' : '' %>><%= label %></option><% } %></select>
      </label>
    </div>
  </section>

  <section class="settings-group card settings-section" id="webhook" aria-labelledby="webhook-title">
    <header class="card-head">
      <h2 id="webhook-title"><%- include('../partials/icon', { name: 'zap' }) %><%= t('admin.settings.webhook_title') %></h2>
      <p><%= t('admin.settings.webhook_blurb') %></p>
    </header>
    <div class="card-body">
      <label class="field"><span><%= t('admin.settings.webhook_url') %></span><input name="webhook_url" value="<%= values.webhook_url %>" maxlength="500" placeholder="<%= t('admin.settings.webhook_url_placeholder') %>" inputmode="url" autocomplete="off" class="mono"><small><%= t('admin.settings.webhook_url_help') %></small></label>
      <label class="field"><span><%= t('admin.settings.webhook_secret') %></span><input name="webhook_secret" value="<%= values.webhook_secret %>" maxlength="200" autocomplete="off" class="mono"><small><%= t('admin.settings.webhook_secret_help') %></small></label>
      <div class="field">
        <fieldset>
          <legend><%= t('admin.settings.events_to_send') %></legend>
          <% for (const [event, info] of Object.entries(webhookEvents)) { %>
            <label class="choice-field"><input type="checkbox" name="<%= info.setting %>" value="1" <%= values[info.setting] === '1' ? 'checked' : '' %>><span><%= info.label %> <code class="muted"><%= event %></code></span></label>
          <% } %>
        </fieldset>
      </div>
      <div class="actions"><button class="btn" type="submit" name="action" value="webhook_test"><%- include('../partials/icon', { name: 'send' }) %><%= locale === 'pt-BR' ? 'Salvar e enviar evento de teste' : 'Save and send a test event' %></button></div>
    </div>
  </section>

  <div class="save-bar">
    <button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('admin.settings.save_changes') %></button>
    <span class="muted" data-dirty-note hidden><%= t('admin.settings.unsaved_changes') %></span>
    <button class="linklike push" type="submit" name="action" value="reset" formnovalidate onclick="return confirm('<%= t('admin.settings.confirm_reset') %>')"><%= t('admin.settings.reset_defaults') %></button>
  </div>
</form>
</div>
</div>

<script>
  // Live preview of the banner while editing.
  const prev = document.getElementById('banner-preview');
  const bind = (name, fn) => document.querySelector(`[name=${name}]`)?.addEventListener('input', (e) => fn(e.target));
  const showHex = (el) => { document.querySelector(`[data-color-for=${el.name}]`).textContent = el.value.toUpperCase(); };
  bind('banner_color', (el) => { prev.style.setProperty('--banner', el.value); showHex(el); });
  bind('banner_text_color', (el) => { prev.style.setProperty('--banner-ink', el.value); showHex(el); });
  bind('site_name', (el) => { document.getElementById('preview-title').textContent = el.value || <%- JSON.stringify(defaults.site_name) %>; });
  bind('tagline', (el) => { document.getElementById('preview-tagline').textContent = el.value; });
  bind('ticket_prefix', (el) => { document.getElementById('ticket-example').textContent = (el.value.trim() ? el.value.trim() : '#') + '0042'; });
  bind('banner_image', (el) => {
    const file = el.files?.[0];
    if (!file) return;
    prev.style.backgroundImage = `url(${URL.createObjectURL(file)})`;
    prev.classList.add('banner-image');
  });
</script>
<%- include('../partials/foot') %>
