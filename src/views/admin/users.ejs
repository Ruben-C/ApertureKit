<%- include('../partials/head', { wide: true }) %>
<% const byRole = Object.groupBy(users, (u) => u.role); %>
<div class="with-subnav">
<%- include('../partials/admin_nav') %>
<div>
<div class="page-head">
  <div>
    <h1><%= t('admin.users.title') %></h1>
    <p class="lede"><%- t('admin.users.summary', { total: users.length, personLabel: users.length === 1 ? t('admin.users.person_singular') : t('admin.users.person_plural'), admins: (byRole.admin || []).length, adminPlural: (byRole.admin || []).length === 1 ? '' : 's', editors: (byRole.editor || []).length, editorPlural: (byRole.editor || []).length === 1 ? '' : 's', members: (byRole.member || []).length, memberPlural: (byRole.member || []).length === 1 ? '' : 's' }) %></p>
  </div>
  <div class="page-actions">
    <button class="btn btn-primary" type="button" data-dialog-open="add-person"><%- include('../partials/icon', { name: 'plus' }) %><%= t('admin.users.add_person') %></button>
  </div>
</div>

<% if (users.length > 5) { %>
<div class="toolbar">
  <form class="search" role="search" data-no-busy style="margin-left:0">
    <%- include('../partials/icon', { name: 'search' }) %>
    <label class="visually-hidden" for="people-filter"><%= t('admin.users.filter_placeholder') %></label>
    <input id="people-filter" type="search" data-filter="people" placeholder="<%= t('admin.users.filter_placeholder') %>" autocomplete="off">
  </form>
</div>
<% } %>

<div class="card table-wrap" id="people">
  <table class="table stacked">
    <thead><tr><th><%= t('admin.users.col_person') %></th><th><%= t('admin.users.col_role') %></th><th><%= t('admin.users.col_signs_in') %></th><th><%= t('admin.users.col_last_active') %></th><th class="num"><%= t('admin.users.col_requests') %></th><th><span class="visually-hidden"><%= t('common.actions') %></span></th></tr></thead>
    <tbody>
      <% for (const u of users) { %>
        <tr data-filter-item>
          <td>
            <span class="person">
              <span class="avatar" style="--hue:<%= hue(u.name) %>" aria-hidden="true"><%= initials(u.name) %></span>
              <span><strong><%= u.name %><% if (u.id === user.id) { %> <span class="muted" style="font-weight:400"><%= t('common.you') %></span><% } %></strong><small><%= u.email %></small></span>
            </span>
          </td>
          <td data-label="<%= t('admin.users.col_role') %>">
            <form method="post" action="/admin/users/<%= u.id %>" class="inline" data-no-busy>
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="action" value="role">
              <select name="role" aria-label="Role for <%= u.name %>" onchange="this.form.requestSubmit()">
                <% for (const r of roles) { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option><% } %>
              </select>
              <noscript><button class="linklike" type="submit"><%= t('common.set') %></button></noscript>
            </form>
          </td>
          <td data-label="<%= t('admin.users.col_signs_in') %>"><% const via = signsInWith.get(u.id) || []; %><%= via.length ? via.join(', ') : (u.password_hash ? (locale === 'pt-BR' ? 'Senha' : 'Password') : '—') %></td>
          <% const active = sessions.get(u.id); %>
          <td data-label="<%= t('admin.users.col_last_active') %>"><% if (active) { %><time datetime="<%= active.lastSeen.replace(' ', 'T') %>Z" title="<%= fmtDate(active.lastSeen) %>"><%= fmtAgo(active.lastSeen) %></time><small><%- t('admin.users.active_sessions', { count: active.count, plural: active.count === 1 ? '' : 's' }) %></small><% } else { %><span class="muted"><%= t('common.signed_out') %></span><% } %></td>
          <td class="num" data-label="<%= t('admin.users.col_requests') %>"><%= u.request_count %></td>
          <td>
            <div class="row-actions">
              <details class="inline-details">
                <summary><%= t('admin.users.change_password') %></summary>
                <form method="post" action="/admin/users/<%= u.id %>">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="action" value="password">
                  <input type="password" name="password" minlength="8" required placeholder="<%= t('admin.users.new_password_placeholder') %>" aria-label="New password for <%= u.name %>" autocomplete="new-password">
                  <button class="btn btn-sm" type="submit"><%= t('common.set') %></button>
                </form>
              </details>
              <% if (active && (u.id !== user.id || active.count > 1)) { %>
                <form method="post" action="/admin/users/<%= u.id %>" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="icon-btn" type="submit" name="action" value="signout" aria-label="<%= u.id === user.id ? (locale === 'pt-BR' ? 'Desconectar em outros dispositivos' : 'Sign yourself out on other devices') : (locale === 'pt-BR' ? `Desconectar ${u.name} em todos os lugares` : `Sign ${u.name} out everywhere`) %>" title="<%= u.id === user.id ? (locale === 'pt-BR' ? 'Desconectar outros dispositivos' : 'Sign out other devices') : t('admin.users.sign_out_everywhere') %>"><%- include('../partials/icon', { name: 'logout' }) %></button>
                </form>
              <% } %>
              <% if (u.id !== user.id) { %>
                <span class="divider"></span>
                <form method="post" action="/admin/users/<%= u.id %>" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="icon-btn icon-btn-danger" type="submit" name="action" value="delete" aria-label="<%= locale === 'pt-BR' ? `Remover ${u.name}` : `Remove ${u.name}` %>" title="<%= t('common.remove') %>" onclick="return confirm('<%= locale === 'pt-BR' ? `Remover ${u.name} e todas as suas solicitações?` : `Remove ${u.name} and all of their requests?` %>')"><%- include('../partials/icon', { name: 'trash' }) %></button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<dialog class="dialog" id="add-person" aria-labelledby="add-person-title" <%= locals.error ? 'data-open' : '' %>>
  <form method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="dialog-head">
      <div><h2 id="add-person-title"><%= t('admin.users.dialog_add_title') %></h2><% if (signIn.buttons.length || signIn.ldap) { %><p><%= t('admin.users.password_optional_help') %></p><% } %></div>
      <button class="icon-btn" type="button" data-dialog-close aria-label="<%= t('common.close') %>"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <div class="dialog-body">
      <% if (locals.error) { %><p class="field-error" role="alert" style="margin:0"><%- include('../partials/icon', { name: 'alert' }) %><span><%= error %></span></p><% } %>
      <label class="field"><span><%= t('admin.users.name_label') %></span><input name="name" value="<%= values.name || '' %>" required autocomplete="off"></label>
      <label class="field"><span><%= t('admin.users.email_label') %></span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="off"></label>
      <div class="form-row">
        <label class="field"><span><%= t('admin.users.password_optional') %></span><input type="password" name="password" minlength="8" <%= (signIn.buttons.length || signIn.ldap) ? '' : 'required' %> autocomplete="new-password"></label>
        <label class="field"><span><%= t('admin.users.role_label') %></span>
          <select name="role"><% for (const r of roles) { %><option value="<%= r %>" <%= (values.role || settings.default_role) === r ? 'selected' : '' %>><%= r %></option><% } %></select>
        </label>
      </div>
    </div>
    <div class="dialog-foot">
      <button class="btn" type="button" data-dialog-close><%= t('common.cancel') %></button>
      <button class="btn btn-primary" type="submit"><%= t('admin.users.add_person') %></button>
    </div>
  </form>
</dialog>
<noscript><style>dialog.dialog { display: block; position: static; margin: 1.5rem 0; width: auto; }</style></noscript>
</div>
</div>
<%- include('../partials/foot') %>
