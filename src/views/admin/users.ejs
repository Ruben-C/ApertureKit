<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1>People</h1>
    <p class="lede">Members send requests. Editors also build forms and work the queue. Administrators also change settings and manage people.</p>
  </div>
</div>
<%- include('../partials/admin_nav') %>

<div class="settings settings-wide">
  <div class="card table-wrap">
    <table class="table stacked">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Signs in with</th><th class="num">Requests</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
      <tbody>
        <% for (const u of users) { %>
          <tr>
            <td><strong><%= u.name %></strong><% if (u.id === user.id) { %> <span class="muted">(you)</span><% } %></td>
            <td><%= u.email %></td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="action" value="role">
                <select name="role" aria-label="Role for <%= u.name %>" onchange="this.form.requestSubmit()">
                  <% for (const r of roles) { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option><% } %>
                </select>
                <noscript><button class="linklike" type="submit">Set</button></noscript>
              </form>
            </td>
            <td data-label="Signs in with"><% const via = signsInWith.get(u.id) || []; %><%= via.length ? via.join(', ') : (u.password_hash ? 'Password' : '—') %></td>
            <td class="num" data-label="Requests"><%= u.request_count %></td>
            <td>
              <div class="row-actions">
                <details class="inline-details">
                  <summary>Change password</summary>
                  <form method="post" action="/admin/users/<%= u.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="action" value="password">
                    <input type="password" name="password" minlength="8" required placeholder="New password" aria-label="New password for <%= u.name %>" autocomplete="new-password">
                    <button class="btn" type="submit">Set</button>
                  </form>
                </details>
                <% if (u.id !== user.id) { %>
                  <form method="post" action="/admin/users/<%= u.id %>" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="linklike danger" type="submit" name="action" value="delete" onclick="return confirm('Remove <%= u.name %> and all of their requests?')">Remove</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <form method="post" action="/admin/users" class="settings-group card">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <header>
      <h2>Add a person</h2>
      <% if (signIn.buttons.length || signIn.ldap) { %><p>Leave the password blank if they will sign in through single sign-on or the directory.</p><% } %>
    </header>
    <% if (locals.error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
    <div class="form-row">
      <label class="field"><span>Name</span><input name="name" value="<%= values.name || '' %>" required autocomplete="off"></label>
      <label class="field"><span>Email</span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="off"></label>
      <label class="field"><span>Password</span><input type="password" name="password" minlength="8" <%= (signIn.buttons.length || signIn.ldap) ? '' : 'required' %> autocomplete="new-password"></label>
      <label class="field"><span>Role</span>
        <select name="role"><% for (const r of roles) { %><option value="<%= r %>" <%= (values.role || settings.default_role) === r ? 'selected' : '' %>><%= r %></option><% } %></select>
      </label>
    </div>
    <div class="actions"><button class="btn btn-primary" type="submit">Add person</button></div>
  </form>
</div>
<%- include('../partials/foot') %>
